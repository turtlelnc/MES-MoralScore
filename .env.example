# MES-MoralScore 运行配置。复制为 .env 并按学校实际情况填写。
# 生产环境必须配置至少 32 位随机 APP_SECRET，否则服务拒绝启动。
PORT=8080
HOST=127.0.0.1
NODE_ENV=development
# 数据目录（SQLite、私有证据文件、备份清单）
DATA_DIR=./data
# 仅当启用生产模式时必填：`node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
APP_SECRET=请替换为至少32位随机字符串
# 浏览器访问的精确 Origin（无末尾斜杠），用于同源写入校验与分享链接拼接
# APP_ORIGIN=http://127.0.0.1:8787
# 反向代理/CDN 部署时的可信代理跳数；直连部署保持注释
# TRUST_PROXY_HOPS=1
# 备份目标目录（必须在 DATA_DIR 之外），留空时备份接口返回明确错误
# BACKUP_DIR=D:/moral-backups
BACKUP_KEEP_RECENT=24
# 会话有效期（天）
SESSION_DAYS=7
# 登录失败限流：窗口内最多失败次数 / 窗口秒数
LOGIN_MAX_FAILURES=8
LOGIN_WINDOW_SECONDS=600
# 证据文件上限（MB），仅允许 png/jpg/webp/pdf
EVIDENCE_MAX_MB=8
# 生产环境启用 Secure Cookie + HSTS；本地 http 部署必须保持 0
COOKIE_SECURE=0
